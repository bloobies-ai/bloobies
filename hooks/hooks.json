        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs"
            ],
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
